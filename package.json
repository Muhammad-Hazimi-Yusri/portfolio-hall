{
  "name": "portfolio-hall",
  "private": true,
  "version": "3.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node tools/check-portfolio.mjs --build",
    "preview": "vite preview",
    "community:local": "node tools/community-local.mjs",
    "check:community": "node tools/check-community.mjs && node tools/check-community-data.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:portfolio": "node tools/check-portfolio.mjs",
    "check:logos": "node tools/check-logo-displays.mjs",
    "check:scroll": "node tools/check-hall-scroll.mjs",
    "check:hall": "node tools/check-hall-layout.mjs",
    "check:portals": "node tools/check-portals.mjs",
    "check:movement": "node tools/check-locomotion.mjs",
    "check:navigation": "node tools/check-hall-navigation.mjs",
    "check:look": "node tools/check-browse-look.mjs",
    "check:exhibits": "node tools/check-exhibit-geometry.mjs",
    "check:audio": "node tools/check-spatial-sound.mjs",
    "check:avvr": "node tools/check-avvr-mesh.mjs",
    "capture:web": "node tools/capture-web-screenshots.mjs",
    "capture:video": "node tools/capture-video-frames.mjs",
    "capture:update": "node tools/update-pois-thumbnails.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^7.34.0",
    "@babylonjs/loaders": "^7.34.0",
    "@babylonjs/materials": "^7.34.0",
    "nipplejs": "^0.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
